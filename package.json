{
  "name": "shinobi-rpg",
  "productName": "Shinobi RPG",
  "private": true,
  "version": "0.1.0",
  "description": "A text-based shinobi life-sim RPG.",
  "main": "electron/dist/main.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run arch && npm run test && npm run build",
    "build:release": "node scripts/build-release.mjs",
    "check:release": "npm run build:release && node scripts/check-release.mjs dist-release",
    "desktop:build": "node -e \"require('node:fs').rmSync('electron/dist',{recursive:true,force:true})\" && tsc -p electron/tsconfig.build.json",
    "desktop:dev": "npm run desktop:build && node scripts/desktop-dev.mjs",
    "desktop:start": "npm run build:release && npm run desktop:build && electron .",
    "desktop:dist": "node scripts/desktop-dist.mjs",
    "mobile:sync": "npm run check:release && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.5.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
